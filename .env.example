# Local infrastructure only. Copy to .env if you want to override defaults.
POSTGRES_DB=reftone
POSTGRES_USER=reftone
POSTGRES_PASSWORD=reftone
MINIO_ROOT_USER=reftone
MINIO_ROOT_PASSWORD=reftone-local-only
MINIO_BUCKET=reftone-uploads
SESSION_SECRET=replace-with-at-least-32-random-characters
IMAGE_UPLOAD_MAX_BYTES=31457280
RAW_UPLOAD_MAX_BYTES=41943040
TASK_TTL_HOURS=24

# Qwen visual recognition. Keep the example key empty and put your real key only in .env.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen3.7-plus
VISION_MAX_EDGE=1024
VISION_JPEG_QUALITY=80
